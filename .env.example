# Copy to .env for local development. Never commit .env.
PORT=3000
NODE_ENV=development
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:4200
# SMTP (Brevo) credentials
MAIL_LOGIN_USER=
MAIL_LOGIN_PASS=
# Comma-separated recipients for contact-form messages
MAIL_TO=
# Optional: verified sender address (defaults to MAIL_LOGIN_USER)
MAIL_FROM=
# Optional: SMTP server (defaults to smtp-relay.brevo.com:465)
MAIL_HOST=
MAIL_PORT=
# AWS only: Secrets Manager secret with the MAIL_* keys (set by the template)
MAIL_SECRET_ID=
# Optional: DynamoDB table for rate limiting (set automatically on AWS)
RATE_LIMIT_TABLE=
